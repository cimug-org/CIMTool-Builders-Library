   [Remaining 6 literals hidden]
}

enum TransmissionModeKind <<enumeration>>  {
   anonymous
   both
   normal
}

' UsagePoint inherits from IdentifiedObject
abstract class UsagePoint  <<abstract>> {
}

IdentifiedObject <|-- UsagePoint

IdentifiedObject "+IdentifiedObject 0..1" --> "+Names 0..*" Name2

