left to right direction
hide empty methods

' Adjust the horizontal spacing for better spatial rendering (the PlantUML default is ~20)
skinparam nodesep 20
' Adjust the vertical spacing for better spatial rendering (the PlantUML default is ~30)
skinparam ranksep 30

skinparam BackgroundColor #FFFFFF
skinparam shadowing false
skinparam RoundCorner 5
skinparam BorderColor #454645
skinparam ArrowColor #454645
skinparam FontColor #000000

skinparam class {
  ' Document root element style definition
  BackgroundColor<<Document Root>> #D3FBFE
  FontColor<<Document Root>> #000000
  FontSize<<Document Root>> 18
  AttributeFontColor<<Document Root>> #000000
  AttributeFontSize<<Document Root>> 18
  StereotypeFontColor<<Document Root>> #000000
  StereotypeFontSize<<Document Root>> 14
  HeaderFontColor<<Document Root>> #000000
  
  ' Choice element style definition
  BackgroundColor<<Choice>> #E6E6FF
  FontColor<<Choice>> #000000
  AttributeFontColor<<Choice>> #000000
  StereotypeFontColor<<Choice>> #000000
  HeaderFontColor<<Choice>> #000000
  BorderColor<<Choice>> #454645
  BorderThickness<<Choice>> 1
  
  ' Ref element style definition
  BackgroundColor<<Ref>> #FFDBDB
  FontColor<<Ref>> #000000
  AttributeFontColor<<Ref>> #000000
  StereotypeFontColor<<Ref>> #000000
  HeaderFontColor<<Ref>> #000000
  BorderColor<<Ref>> #454645
  BorderThickness<<Ref>> 1
  
  ' Concrete classes style definition
  BackgroundColor #FFFFE0
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
  HeaderFontColor #000000
  BorderColor #454645
  BorderThickness 1
  
  ' Abstract classes style definition
  BackgroundColor<<abstract>> #E8E8E8
  FontColor<<abstract>> #000000
  AttributeFontColor<<abstract>> #000000
  StereotypeFontColor<<abstract>> #000000
  HeaderFontColor<<abstract>> #000000
  BorderColor<<abstract>> #454645
  BorderThickness<<abstract>> 1
  
  ' Enumerations style definition
  BackgroundColor<<enumeration>> #A9F1A9
  FontColor<<enumeration>> #000000
  AttributeFontColor<<enumeration>> #000000
  StereotypeFontColor<<enumeration>> #000000
  HeaderFontColor <<enumeration>> #000000
  BorderColor<<enumeration>> #454645
  BorderThickness<<enumeration>> 1
  
  ' CIMDatatypes style definition
  BackgroundColor<<CIMDatatype>> #FFEBCD
  FontColor<<CIMDatatype>> #000000
  AttributeFontColor<<CIMDatatype>> #000000
  StereotypeFontColor<<CIMDatatype>> #000000
  HeaderFontColor<<CIMDatatype>> #000000
  BorderColor<<CIMDatatype>> #454645
  BorderThickness<<CIMDatatype>> 1
  
  ' Compound classes style definition
  BackgroundColor<<Compound>> #FFEBCD
  FontColor<<Compound>> #000000
  AttributeFontColor<<Compound>> #000000
  StereotypeFontColor<<Compound>> #000000
  HeaderFontColor<<Compound>> #000000
  BorderColor<<Compound>> #454645
  BorderThickness<<Compound>> 1
  
  ' Primitive classes style definition
  BackgroundColor<<Primitive>> #E6E6FF
  FontColor<<Primitive>> #000000
  AttributeFontColor<<Primitive>> #000000
  StereotypeFontColor<<Primitive>> #000000
  HeaderFontColor<<Primitive>> #000000
  BorderColor<<Primitive>> #454645
  BorderThickness<<Primitive>> 1
  
  ' Errors classes style definition
  BackgroundColor<<error>> #FFC0CB
  FontColor<<error>> #000000
  AttributeFontColor<<error>> #000000
  StereotypeFontColor<<error>> #000000
  HeaderFontColor<<error>> #000000
  BorderColor<<error>> #454645
  BorderThickness<<error>> 1
  
  ' Shadow classes style definition
  BackgroundColor<<ShadowExtension>> #C0C0C0
  FontColor<<ShadowExtension>> #000000
  AttributeFontColor<<ShadowExtension>> #000000
  StereotypeFontColor<<ShadowExtension>> #000000
  HeaderFontColor<<ShadowExtension>> #000000
  BorderColor<<ShadowExtension>> #454645
  BorderThickness<<ShadowExtension>> 1
  
}

skinparam shadowing true

hide <<Document Root>> stereotype
hide <<Choice>> stereotype
hide <<Ref>> stereotype
hide <<abstract>> stereotype
hide <<error>> stereotype

class EndDeviceControls <<Root XSDelement>> <<Document Root>> <<(E, #F3F3F3)>> {
   http://ucaiug.org/2022/EndDeviceControls#
}

EndDeviceControls --> "EndDeviceControl 0..*" EndDeviceControl
EndDeviceControls --> "EndDeviceControlType 0..*" EndDeviceControlType

skinparam note {
  BorderColor #454645
  BorderThickness 1.5
  FontSize 14
  Font Bold
  FontColor #000000
}

' Asset inherits from IdentifiedObject
abstract class Asset <<XSDcomplexType>> <<abstract>> {
}

IdentifiedObject <|-- Asset
' AssetContainer inherits from Asset
abstract class AssetContainer <<XSDcomplexType>> <<abstract>> {
}

Asset <|-- AssetContainer
' EndDevice inherits from AssetContainer
abstract class EndDevice <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>installCode: String [0..1]
   <$empty_icon>isPan: Boolean [0..1]
}

AssetContainer <|-- EndDevice
' EndDeviceAction
abstract class EndDeviceAction <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>command: String [0..1]
}

' EndDeviceControl inherits from IdentifiedObject
class EndDeviceControl <<XSDcomplexType>>  {
   <$empty_icon>drProgramLevel: Integer [0..1]
   <$empty_icon>drProgramMandatory: Boolean [0..1]
   <$empty_icon>issuerID: String [0..1]
   <$empty_icon>priceSignal: Float [0..1]
   <$empty_icon>primaryDeviceTiming: EndDeviceTiming [0..1]
   <$empty_icon>scheduledInterval: EndDeviceControl::DateTimeInterval [1]
}

IdentifiedObject <|-- EndDeviceControl
' EndDeviceControlType inherits from IdentifiedObject
class EndDeviceControlType <<XSDcomplexType>>  {
   <$empty_icon>type: String [0..1]
}

IdentifiedObject <|-- EndDeviceControlType
' IdentifiedObject
abstract class IdentifiedObject <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>mRID: String [1]
}

' Name
abstract class Name <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>name: String [0..1]
}

' Name2
abstract class Name2 <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>name: String [1]
}

' PanDemandResponse
abstract class PanDemandResponse <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>appliance: ControlledAppliance [0..1]
   <$empty_icon>cancelDateTime: DateTime [0..1]
   <$empty_icon>command: String [0..1]
   <$empty_icon>coolingSetpoint: Temperature [0..1]
   <$empty_icon>durationIndefinite: Boolean [0..1]
   <$empty_icon>dutyCycle: PerCent [0..1]
}

' PanDisplay
abstract class PanDisplay <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>command: String [0..1]
   <$empty_icon>confirmationRequired: Boolean [0..1]
   <$empty_icon>startDateTime: DateTime [0..1]
   <$empty_icon>transmissionMode: TransmissionModeKind [0..1]
}

' PanPricing
abstract class PanPricing <<XSDcomplexType>> <<abstract>> {
   <$empty_icon>command: String [0..1]
   <$empty_icon>startDateTime: DateTime [0..1]
}

enum TransmissionModeKind <<XSDsimpleType>> <<enumeration>>  {
   anonymous
   both
   normal
}

' UsagePoint inherits from IdentifiedObject
abstract class UsagePoint <<XSDcomplexType>> <<abstract>> {
}

IdentifiedObject <|-- UsagePoint
EndDevice --> "Names 0..*" Name
EndDevice --> "UsagePoint 1" UsagePoint

' Choice placeholder class for EndDeviceAction
class "EndDeviceAction [0..1]" as Choice::EndDeviceControls::EndDeviceControl::EndDeviceAction::n1 <<Choice>> <<($choice_icon)>> {
}

hide "Choice::EndDeviceControls::EndDeviceControl::EndDeviceAction::n1" attributes

EndDeviceControl --> Choice::EndDeviceControls::EndDeviceControl::EndDeviceAction::n1


Choice::EndDeviceControls::EndDeviceControl::EndDeviceAction::n1 --> "PanDemandResponse 1" PanDemandResponse
Choice::EndDeviceControls::EndDeviceControl::EndDeviceAction::n1 --> "PanDisplay 1" PanDisplay
Choice::EndDeviceControls::EndDeviceControl::EndDeviceAction::n1 --> "PanPricing 1" PanPricing

' Ref placeholder class for EndDeviceControlType
class Ref::EndDeviceControls::EndDeviceControl::EndDeviceControlType::n1 as "@ref  " <<Ref>> <<($ref_icon)>> {
}

hide "Ref::EndDeviceControls::EndDeviceControl::EndDeviceControlType::n1" attributes

EndDeviceControl --> "EndDeviceControlType 1" Ref::EndDeviceControls::EndDeviceControl::EndDeviceControlType::n1
EndDeviceControl --> "EndDevices 0..*" EndDevice
EndDeviceControl --> "UsagePoints 0..*" UsagePoint
UsagePoint --> "Names 0..*" Name2

@enduml
