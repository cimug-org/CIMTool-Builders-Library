              basePropertyClass="http://iec.ch/TC57/CIM-generic#IdentifiedObject"
              minOccurs="0"
              maxOccurs="1">
         <Comment>The name is any free human readable and possibly non unique text naming the object.</Comment>
         <Stereotype label="Attribute">http://langdale.com.au/2005/UML#attribute</Stereotype>
      </Simple>
